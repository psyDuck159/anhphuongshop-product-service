<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
    <!-- === CREDENTIALS CHO NEXUS === -->
    <servers>
        <server>
            <id>nexus-public</id>
            <username>${env.NEXUS_USER}</username>     <!-- Maven sẽ lấy từ biến môi trường -->
            <password>${env.NEXUS_PASS}</password>
        </server>
        <server>
            <id>nexus-releases</id>
            <username>${env.NEXUS_USER}</username>
            <password>${env.NEXUS_PASS}</password>
        </server>
        <server>
            <id>nexus-snapshots</id>
            <username>${env.NEXUS_USER}</username>
            <password>${env.NEXUS_PASS}</password>
        </server>
    </servers>
    <!-->
    <mirrors>
        <mirror>
            <id>nexus-public</id>
            <name>Nexus Public Mirror</name>
            <url>https://nexus.anhld.biz/repository/maven-public/</url>
            <mirrorOf>*</mirrorOf>
        </mirror>
    </mirrors>
    -->
    <!-- MIRROR quan trọng nhất: Tất cả đi thẳng Maven Central, CHỈ trừ nexus-public -->
    <mirrors>
        <mirror>
            <id>central-direct</id>
            <name>Maven Central Direct (không qua Nexus)</name>
            <url>https://repo.maven.apache.org/maven2</url>
            <mirrorOf>*,!nexus-public</mirrorOf>
        </mirror>
    </mirrors>

    <profiles>
        <profile>
            <id>nexus-internal</id>
            <repositories>

                <repository>
                    <id>nexus-public</id>
                    <url>https://nexus.anhld.biz/repository/maven-public/</url>
		    <releases>
			    <enabled>true</enabled>
			    <updatePolicy>never</updatePolicy>
		    </releases>
		    <snapshots>
			    <enabled>true</enabled>
			    <updatePolicy>daily</updatePolicy>    
		    </snapshots>
                </repository>
            </repositories>
        </profile>
    </profiles>

    <activeProfiles>
        <activeProfile>nexus-internal</activeProfile>
    </activeProfiles> 
</settings>
